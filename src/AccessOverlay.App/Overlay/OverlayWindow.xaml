<Window x:Class="AccessOverlay.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:AccessOverlay.Core.Model;assembly=AccessOverlay.Core"
        WindowStyle="None"
        Topmost="True"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BgBrush}"
        FontFamily="Segoe UI"
        Title="Access Overlay Reader"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <DockPanel Margin="8,4" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="SearchBtn" Content="Find" ToolTip="Search text in document (Ctrl+F)" Click="Search_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="FontMinusBtn" Content="A&#x2212;" ToolTip="Smaller text (Ctrl+-)" Click="FontMinus_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="FontPlusBtn" Content="A+" ToolTip="Larger text (Ctrl+=)" Click="FontPlus_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="ThemeBtn" Content="Theme" ToolTip="Cycle colour theme" Click="Theme_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="RefreshBtn" Content="Refresh" ToolTip="Re-read the underlying app or page (F5)" Click="Refresh_Click" Padding="8,3" Margin="0,0,4,0"/>

                        <Button x:Name="SpeakBtn" Content="Read" ToolTip="Read current item (Enter)" Click="Speak_Click" Padding="8,3" Margin="0,0,4,0"/>

                        <Button x:Name="EditBtn" Content="Edit" ToolTip="Edit the selected text field (E)" Click="Edit_Click" Padding="8,3" Margin="0,0,4,0"/>

                        <Button x:Name="ActivateBtn" Content="Press" ToolTip="Activate the control on the page or app under the overlay" Click="Activate_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="SettingsBtn" Content="Settings" ToolTip="Open settings (control panel: web reader, speech, theme)" Click="Controls_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="CopyBtn" Content="Copy" ToolTip="Copy plain text (Ctrl+C)" Click="Copy_Click" Padding="8,3" Margin="0,0,4,0"/>
                        <Button x:Name="CloseBtn" Content="&#x2715;" ToolTip="Close (Esc)" Click="Close_Click" Padding="8,3" Margin="0,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="TitleText" VerticalAlignment="Center" Foreground="{DynamicResource FgBrush}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                </DockPanel>

                <!-- Search Bar Container (Ctrl+F) -->
                <Border x:Name="SearchPanel" Visibility="Collapsed" Background="{DynamicResource SelBgBrush}" Padding="8,4">
                    <DockPanel>
                        <Button x:Name="SearchCloseBtn" Content="&#x2715;" DockPanel.Dock="Right" Click="SearchClose_Click" Padding="6,2" Margin="4,0,0,0"/>
                        <Button x:Name="SearchNextBtn" Content="Next" DockPanel.Dock="Right" Click="SearchNext_Click" Padding="6,2" Margin="4,0,0,0"/>
                        <Button x:Name="SearchPrevBtn" Content="Prev" DockPanel.Dock="Right" Click="SearchPrev_Click" Padding="6,2" Margin="4,0,0,0"/>
                        <TextBlock x:Name="MatchCountText" DockPanel.Dock="Right" Text="0 matches" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="8,0"/>
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" Padding="4,2"/>
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <ListBox x:Name="Blocks" Grid.Row="1" Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 PreviewKeyDown="Blocks_PreviewKeyDown"
                 MouseDoubleClick="Blocks_MouseDoubleClick"
                 SelectionChanged="Blocks_SelectionChanged"
                 FocusVisualStyle="{x:Null}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="Transparent"
                                        Margin="{Binding Depth, Converter={StaticResource DepthMargin}}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelBgBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Resources>
                <DataTemplate DataType="{x:Type core:HeadingBlock}">
                    <TextBlock Text="{Binding Text}" FontWeight="Bold" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgBrush}"
                               AutomationProperties.HeadingLevel="{Binding Level}"
                               Focusable="False">
                        <TextBlock.FontSize>
                            <MultiBinding Converter="{StaticResource HeadingFontSizeMulti}">
                                <Binding Path="Level"/>
                                <Binding Path="FontSize" RelativeSource="{RelativeSource AncestorType=ListBox}"/>
                            </MultiBinding>
                        </TextBlock.FontSize>
                    </TextBlock>
                </DataTemplate>
                <DataTemplate DataType="{x:Type core:ParagraphBlock}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Focusable="False"
                               Foreground="{DynamicResource FgBrush}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type core:ListItemBlock}">
                    <TextBlock TextWrapping="Wrap" Focusable="False" Foreground="{DynamicResource FgBrush}">
                        <Run Text="&#x2022; "/><Run Text="{Binding Text}"/>
                    </TextBlock>
                </DataTemplate>
                <DataTemplate DataType="{x:Type core:ControlBlock}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Focusable="False"
                               Foreground="{DynamicResource AccentBrush}"/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type core:SeparatorBlock}">
                    <Rectangle Height="12" Fill="Transparent"/>
                </DataTemplate>
            </ListBox.Resources>
        </ListBox>

        <!-- Live text input. Whatever you type here is pushed into the real edit
             field in the app or page underneath, keystroke by keystroke. -->
        <Border x:Name="EditBar" Grid.Row="2" Visibility="Collapsed"
                Background="{DynamicResource SelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="EditApplyBtn" Content="Apply" Click="EditApply_Click" Padding="8,3" Margin="0,0,6,0"/>
                    <Button x:Name="EditCancelBtn" Content="Cancel" Click="EditCancel_Click" Padding="8,3"/>
                </StackPanel>
                <TextBlock x:Name="EditLabelText" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource FgBrush}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="0,0,8,0"/>
                <TextBox x:Name="EditBox" AcceptsReturn="False" Padding="4,3"
                         TextChanged="EditBox_TextChanged" KeyDown="EditBox_KeyDown"
                         AutomationProperties.Name="Edit field value"/>
                <PasswordBox x:Name="EditPasswordBox" Visibility="Collapsed" Padding="4,3"
                             PasswordChanged="EditPasswordBox_PasswordChanged" KeyDown="EditBox_KeyDown"
                             AutomationProperties.Name="Protected field value"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="3" Background="{DynamicResource TitleBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="10,3">
                <TextBlock x:Name="SpeechStatusText" DockPanel.Dock="Right" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0"/>
                <TextBlock Text="Enter/Space: press · type to edit fields · ←/→: change combo/spinner value · Esc: close · H: heading · F5: refresh · S: read all · Ctrl+C: copy"
                           Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
